@page
@{
    ViewData["Title"] = "Catégories";
    Layout = "_DashboardLayout";
}

<div class="dashboard-header">
    <div class="dashboard-title">
        <h1>Gestion des Catégories</h1>
        <p>Consultez, ajoutez et modifiez les catégories de produits.</p>
    </div>
    <button class="btn-primary" onclick="loadCategories()">
        <i class="fa-solid fa-rotate-right"></i>
        <span>Actualiser</span>
    </button>
</div>

<div class="glass-card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <h3 class="card-title" style="margin: 0;">Liste des Catégories</h3>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex: 1; max-width: 400px;">
            <div style="position: relative; width: 100%;">
                <input type="text" id="category_search_input" placeholder="🔍 Rechercher une catégorie..." oninput="filterCategoriesTable()" style="width: 100%; padding-left: 2rem;">
                <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;"></i>
            </div>
        </div>
        <button class="btn-primary" id="btnNewCategory" style="padding: 0.5rem 1rem; font-size: 0.9rem;" onclick="openCategoryModal()">
            <i class="fa-solid fa-plus"></i> Nouvelle Catégorie
        </button>
    </div>
    <div class="table-responsive">
        <table class="data-table" id="categoriesTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Nombre de Produits</th>
                    <th>Date de Création</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="6" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Catégorie -->
<div class="modal-overlay" id="categoryModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="categoryModalTitle">Nouvelle Catégorie</h3>
            <button class="modal-close" onclick="closeCategoryModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="categoryForm" onsubmit="saveCategory(event)">
            <input type="hidden" id="c_id">
            <div class="form-group">
                <label>Nom de la catégorie *</label>
                <input type="text" id="c_name" required placeholder="Ex: Alimentation, Boissons...">
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea id="c_description" rows="3" placeholder="Description facultative de la catégorie..." style="width: 100%; border-radius: 8px; padding: 0.75rem; background: var(--bg-surface-secondary); color: var(--text-primary); border: 1px solid var(--border-color);"></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeCategoryModal()">Annuler</button>
                <button type="submit" class="btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let allCategories = [];

        function openCategoryModal(id = null, name = '', description = '') {
            document.getElementById('categoryForm').reset();
            const isEdit = id !== null;
            document.getElementById('categoryModalTitle').innerText = isEdit ? 'Modifier la Catégorie' : 'Nouvelle Catégorie';
            
            if (isEdit) {
                document.getElementById('c_id').value = id;
                document.getElementById('c_name').value = name;
                document.getElementById('c_description').value = description || '';
            } else {
                document.getElementById('c_id').value = '';
            }
            document.getElementById('categoryModal').classList.add('show');
        }

        function closeCategoryModal() {
            document.getElementById('categoryModal').classList.remove('show');
        }

        async function saveCategory(e) {
            e.preventDefault();
            
            const token = localStorage.getItem("jwtToken");
            if (!token) {
                window.location.href = "/Login";
                return;
            }

            const id = document.getElementById('c_id').value;
            const name = document.getElementById('c_name').value.trim();
            const description = document.getElementById('c_description').value.trim();
            
            const isEdit = id !== '';
            
            const requestBody = {
                name: name,
                description: description || null
            };

            try {
                const url = isEdit ? '/api/categories/' + id : '/api/categories';
                const method = isEdit ? 'PUT' : 'POST';
                
                const resp = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(requestBody)
                });

                if (!resp.ok) {
                    const errText = await resp.text();
                    let errMsg = errText;
                    try {
                        const errJson = JSON.parse(errText);
                        if (errJson.message) errMsg = errJson.message;
                    } catch (e) { }
                    throw new Error(errMsg);
                }

                closeCategoryModal();
                showToast(isEdit ? 'Catégorie modifiée avec succès' : 'Catégorie créée avec succès', 'success');
                loadCategories();
            } catch (error) {
                console.error(error);
                showToast("Erreur: " + error.message, "danger");
            }
        }

        function deleteCategory(id, name) {
            showConfirmModal(`Êtes-vous sûr de vouloir supprimer la catégorie "${name}" ?`, async () => {
                const token = localStorage.getItem("jwtToken");
                try {
                    const resp = await fetch('/api/categories/' + id, {
                        method: 'DELETE',
                        headers: {
                            'Authorization': `Bearer ${token}`
                        }
                    });
                    
                    if (!resp.ok) {
                        const errText = await resp.text();
                        let errMsg = "Échec de la suppression";
                        try {
                            const errJson = JSON.parse(errText);
                            if (errJson.message) errMsg = errJson.message;
                        } catch(e) {}
                        throw new Error(errMsg);
                    }
                    
                    showToast('Catégorie supprimée avec succès', 'success');
                    loadCategories();
                } catch (error) {
                    showToast("Erreur: " + error.message, "danger");
                }
            });
        }

        function renderCategoriesTable(categories) {
            const tbody = document.querySelector('#categoriesTable tbody');
            if (!categories || categories.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color: var(--text-muted); padding: 2rem;">Aucune catégorie trouvée.</td></tr>';
                return;
            }

            const token = localStorage.getItem("jwtToken");
            let userRole = '';
            try {
                const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
                userRole = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || '';
            } catch (e) {}

            const isResponsable = userRole === 'Responsable';

            tbody.innerHTML = categories.map(c => {
                const id = c.id ?? c.Id;
                const name = (c.name ?? c.Name ?? '').replace(/'/g, "\\'");
                const desc = (c.description ?? c.Description ?? '').replace(/'/g, "\\'");
                const rawDesc = c.description ?? c.Description ?? '-';
                const count = c.productCount ?? c.ProductCount ?? 0;
                const date = c.createdAt ?? c.CreatedAt ? new Date(c.createdAt ?? c.CreatedAt).toLocaleDateString('fr-FR') : '-';

                return `
                    <tr>
                        <td><span class="badge" style="background: rgba(148, 163, 184, 0.2); color: var(--text-muted);">#${id}</span></td>
                        <td style="font-weight: 600; color: var(--text-primary);">${c.name ?? c.Name}</td>
                        <td style="color: var(--text-secondary); max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${rawDesc}</td>
                        <td>
                            <span class="badge" style="background: rgba(99, 102, 241, 0.2); color: var(--primary);">
                                ${count} produit${count > 1 ? 's' : ''}
                            </span>
                        </td>
                        <td style="color: var(--text-muted); font-size: 0.9rem;">${date}</td>
                        <td style="white-space: nowrap;">
                            <button class="btn-icon" title="Modifier" style="color: var(--primary);" onclick="openCategoryModal(${id}, '${name}', '${desc}')">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            ${isResponsable ? `
                            <button class="btn-icon" title="Supprimer" style="color: var(--danger); margin-left: 0.5rem;" onclick="deleteCategory(${id}, '${name}')">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>` : ''}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function filterCategoriesTable() {
            const query = (document.getElementById('category_search_input').value || '').trim().toLowerCase();
            if (!query) {
                renderCategoriesTable(allCategories);
                return;
            }

            const filtered = allCategories.filter(c => {
                const name = (c.name ?? c.Name ?? '').toLowerCase();
                const desc = (c.description ?? c.Description ?? '').toLowerCase();
                const id = String(c.id ?? c.Id ?? '');
                return name.includes(query) || desc.includes(query) || id.includes(query);
            });

            renderCategoriesTable(filtered);
        }

        async function loadCategories() {
            const token = localStorage.getItem("jwtToken");
            if (!token) {
                window.location.href = "/Login";
                return;
            }
            
            const tbody = document.querySelector('#categoriesTable tbody');
            tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement...</td></tr>';
            
            try {
                const resp = await fetch('/api/categories', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                if (resp.status === 401) {
                    window.location.href = "/Login";
                    return;
                }
                if (!resp.ok) throw new Error('Erreur API lors du chargement des catégories');
                
                allCategories = await resp.json() || [];
                filterCategoriesTable();
                
            } catch (e) {
                console.error(e);
                tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color: var(--danger); padding: 2rem;">Erreur lors du chargement des catégories.</td></tr>';
            }
        }
        
        document.addEventListener('DOMContentLoaded', loadCategories);
    </script>
}
