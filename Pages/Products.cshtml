@page
@{
    ViewData["Title"] = "Produits";
    Layout = "_DashboardLayout";
}

<div class="dashboard-header">
    <div class="dashboard-title">
        <h1>Gestion des Produits</h1>
        <p>Consultez, ajoutez et modifiez les produits du catalogue.</p>
    </div>
    <button class="btn-primary" onclick="loadProducts()">
        <i class="fa-solid fa-rotate-right"></i>
        <span>Actualiser</span>
    </button>
</div>

<div class="glass-card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 class="card-title">Liste des Produits</h3>
        <button class="btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;" onclick="openProductModal()">
            <i class="fa-solid fa-plus"></i> Nouveau
        </button>
    </div>
    <div class="table-responsive">
        <table class="data-table" id="productsTable">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Nom</th>
                    <th>Catégorie</th>
                    <th>Prix Détaillant</th>
                    <th>Prix Moyen</th>
                    <th>Dernier Prix</th>
                    <th>Stock</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Product -->
<div class="modal-overlay" id="productModal">
    <div class="modal-content" style="max-width: 650px;">
        <div class="modal-header">
            <h3 id="productModalTitle">Nouveau Produit</h3>
            <button class="modal-close" onclick="closeProductModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="productForm" onsubmit="saveProduct(event)">
            <input type="hidden" id="p_id">
            <div class="form-group">
                <label>Nom du produit</label>
                <input type="text" id="p_name" required placeholder="Ex: Macadamia 500g">
            </div>
            <div class="form-group" style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <label>SKU</label>
                    <input type="text" id="p_sku" placeholder="Ex: PRD-001">
                </div>
                <div style="flex: 1;">
                    <label>Catégorie</label>
                    <div style="position: relative; margin-bottom: 0.35rem;">
                        <input type="text" id="p_category_search" placeholder="🔍 Filtrer catégorie..." oninput="filterCategoryOptionsInModal()" style="padding-left: 1.8rem; font-size: 0.85rem; padding-top: 0.35rem; padding-bottom: 0.35rem;">
                        <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 0.6rem; top: 50%; transform: translateY(-50%); font-size: 0.75rem; color: var(--text-muted); pointer-events: none;"></i>
                    </div>
                    <select id="p_category">
                        <option value="1">Alimentation</option>
                    </select>
                </div>
            </div>
            <div class="form-group" style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <label>Prix Détaillant (FCFA)</label>
                    <input type="number" step="0.01" id="p_retail_price" required placeholder="Prix standard">
                </div>
                <div style="flex: 1;">
                    <label>Prix Moyen (FCFA)</label>
                    <input type="number" step="0.01" id="p_medium_price" required placeholder="Prix intermédiaire">
                </div>
                <div style="flex: 1;">
                    <label>Dernier Prix (FCFA)</label>
                    <input type="number" step="0.01" id="p_last_price" required placeholder="Prix plancher/min">
                </div>
            </div>
            <div class="form-group" style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <label>Stock initial</label>
                    <input type="number" id="p_stock" value="0" required>
                </div>
                <div style="flex: 1;">
                    <label>Seuil d'alerte</label>
                    <input type="number" id="p_minstock" value="5" required>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeProductModal()">Annuler</button>
                <button type="submit" class="btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let allProductCategories = [];

        function renderCategorySelectOptions(categoriesToRender, selectedId = null) {
            const select = document.getElementById('p_category');
            if (!categoriesToRender || categoriesToRender.length === 0) {
                select.innerHTML = '<option disabled selected value="">Aucune catégorie trouvée</option>';
                return;
            }

            select.innerHTML = categoriesToRender.map(c => 
                `<option value="${c.id ?? c.Id}">${c.name ?? c.Name}</option>`
            ).join('');

            if (selectedId) {
                select.value = selectedId;
            } else if (categoriesToRender.length === 1) {
                select.value = categoriesToRender[0].id ?? categoriesToRender[0].Id;
            }
        }

        function filterCategoryOptionsInModal() {
            const query = (document.getElementById('p_category_search').value || '').trim().toLowerCase();
            const currentSelected = document.getElementById('p_category').value;
            if (!query) {
                renderCategorySelectOptions(allProductCategories, currentSelected);
                return;
            }

            const filtered = allProductCategories.filter(c => {
                const name = (c.name ?? c.Name ?? '').toLowerCase();
                const desc = (c.description ?? c.Description ?? '').toLowerCase();
                return name.includes(query) || desc.includes(query);
            });

            renderCategorySelectOptions(filtered, currentSelected);
        }

        function openProductModal(id = null, name = '', sku = '', categoryId = null, retailPrice = 0, mediumPrice = 0, lastPrice = 0, minStock = 5, currentStock = 0) {
            document.getElementById('productForm').reset();
            const searchCategoryInput = document.getElementById('p_category_search');
            if (searchCategoryInput) searchCategoryInput.value = '';
            
            renderCategorySelectOptions(allProductCategories, categoryId);

            const isEdit = id !== null;
            document.getElementById('productModalTitle').innerText = isEdit ? 'Modifier le Produit' : 'Nouveau Produit';
            
            if (isEdit) {
                document.getElementById('p_id').value = id;
                document.getElementById('p_name').value = name;
                document.getElementById('p_sku').value = sku;
                if (categoryId) document.getElementById('p_category').value = categoryId;
                document.getElementById('p_retail_price').value = retailPrice;
                document.getElementById('p_medium_price').value = mediumPrice || retailPrice;
                document.getElementById('p_last_price').value = lastPrice || mediumPrice || retailPrice;
                document.getElementById('p_minstock').value = minStock;
                document.getElementById('p_stock').value = currentStock;
                document.getElementById('p_stock').disabled = true;
                document.getElementById('p_stock').title = "Le stock ne peut être modifié que via les mouvements de stock";
            } else {
                document.getElementById('p_id').value = '';
                document.getElementById('p_retail_price').value = '';
                document.getElementById('p_medium_price').value = '';
                document.getElementById('p_last_price').value = '';
                document.getElementById('p_stock').value = '0';
                document.getElementById('p_stock').disabled = false;
                document.getElementById('p_stock').title = "";
            }
            document.getElementById('productModal').classList.add('show');
        }

        function closeProductModal() {
            document.getElementById('productModal').classList.remove('show');
        }

        async function saveProduct(e) {
            e.preventDefault();
            
            const token = localStorage.getItem("jwtToken");
            if (!token) {
                window.location.href = "/Login";
                return;
            }

            const id = document.getElementById('p_id').value;
            const name = (document.getElementById('p_name').value || '').trim();
            const rawSku = (document.getElementById('p_sku').value || '').trim();
            const sku = rawSku.length > 0 ? rawSku : null;
            const rawCatId = parseInt(document.getElementById('p_category').value);
            const categoryId = isNaN(rawCatId) || rawCatId <= 0 ? null : rawCatId;
            const retailPrice = parseFloat(document.getElementById('p_retail_price').value) || 0;
            const mediumPrice = parseFloat(document.getElementById('p_medium_price').value) || retailPrice;
            const lastPrice = parseFloat(document.getElementById('p_last_price').value) || mediumPrice;
            const minStockThreshold = parseInt(document.getElementById('p_minstock').value) || 0;
            const initialStock = parseInt(document.getElementById('p_stock').value) || 0;
            
            const isEdit = id !== '';
            
            let requestBody;
            if (isEdit) {
                requestBody = {
                    name: name,
                    sku: sku,
                    retailPrice: retailPrice,
                    mediumPrice: mediumPrice,
                    lastPrice: lastPrice,
                    sellingPrice: retailPrice,
                    minStockThreshold: minStockThreshold,
                    categoryId: categoryId
                };
            } else {
                requestBody = {
                    name: name,
                    sku: sku,
                    description: "",
                    purchasePrice: 0,
                    retailPrice: retailPrice,
                    mediumPrice: mediumPrice,
                    lastPrice: lastPrice,
                    sellingPrice: retailPrice,
                    initialStock: initialStock,
                    minStockThreshold: minStockThreshold,
                    unit: "pcs",
                    categoryId: categoryId
                };
            }

            try {
                const url = isEdit ? '/api/products/' + id : '/api/products';
                const method = isEdit ? 'PUT' : 'POST';
                
                const resp = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(requestBody)
                });

                if (!resp.ok) {
                    const errText = await resp.text();
                    let errMsg = errText;
                    try {
                        const errJson = JSON.parse(errText);
                        if (errJson.message) errMsg = errJson.message;
                    } catch (e) { }
                    throw new Error(errMsg);
                }

                closeProductModal();
                showToast(isEdit ? 'Produit mis à jour' : 'Produit créé avec succès', 'success');
                loadProducts();
            } catch (error) {
                console.error(error);
                showToast("Erreur: " + error.message, "danger");
            }
        }

        function deleteProduct(id) {
            showConfirmModal("Êtes-vous sûr de vouloir supprimer ce produit ? Cette action est irréversible.", async () => {
                const token = localStorage.getItem("jwtToken");
                try {
                    const resp = await fetch('/api/products/' + id, {
                        method: 'DELETE',
                        headers: {
                            'Authorization': `Bearer ${token}`
                        }
                    });
                    
                    if (!resp.ok) throw new Error("Échec de la suppression");
                    
                    showToast('Produit supprimé', 'success');
                    loadProducts();
                } catch (error) {
                    showToast("Erreur: " + error.message, "danger");
                }
            });
        }

        async function loadProducts() {
            const token = localStorage.getItem("jwtToken");
            if (!token) {
                window.location.href = "/Login";
                return;
            }
            
            const tbody = document.querySelector('#productsTable tbody');
            tbody.innerHTML = '<tr><td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement...</td></tr>';
            
            try {
                const resp = await fetch('/api/products?pageNumber=1&pageSize=50', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                if (resp.status === 401) {
                    window.location.href = "/Login";
                    return;
                }
                if (!resp.ok) throw new Error('Erreur API');
                
                const result = await resp.json();
                const products = result.items || result;
                
                if (!products || products.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Aucun produit trouvé.</td></tr>';
                    return;
                }
                
                tbody.innerHTML = products.map(p => {
                    const retail = (p.retailPrice ?? p.RetailPrice ?? p.sellingPrice ?? p.SellingPrice ?? 0);
                    const medium = (p.mediumPrice ?? p.MediumPrice ?? retail);
                    const last = (p.lastPrice ?? p.LastPrice ?? medium);
                    return `
                    <tr>
                        <td><span class="badge" style="background: rgba(148, 163, 184, 0.2); color: var(--text-muted);">${p.sku || p.sKU || p.SKU || 'N/A'}</span></td>
                        <td style="font-weight: 500;">${p.name || p.Name}</td>
                        <td>${p.categoryName || p.CategoryName || '-'}</td>
                        <td style="font-weight: 600; color: var(--text-primary);">${retail.toFixed(2)} FCFA</td>
                        <td style="font-weight: 500; color: #38bdf8;">${medium.toFixed(2)} FCFA</td>
                        <td style="font-weight: 500; color: #f59e0b;">${last.toFixed(2)} FCFA</td>
                        <td>
                            <span class="badge" style="background: ${(p.currentStock ?? p.CurrentStock) <= (p.minStockThreshold ?? p.MinStockThreshold) ? 'rgba(239, 68, 68, 0.2)' : 'rgba(34, 197, 94, 0.2)'}; color: ${(p.currentStock ?? p.CurrentStock) <= (p.minStockThreshold ?? p.MinStockThreshold) ? 'var(--danger)' : 'var(--success)'};">
                                ${p.currentStock ?? p.CurrentStock} ${p.unit || p.Unit}
                            </span>
                        </td>
                        <td>
                            <span class="badge" style="background: ${(p.isActive ?? p.IsActive) ? 'rgba(34, 197, 94, 0.2)' : 'rgba(239, 68, 68, 0.2)'}; color: ${(p.isActive ?? p.IsActive) ? 'var(--success)' : 'var(--danger)'};">
                                ${(p.isActive ?? p.IsActive) ? 'Actif' : 'Inactif'}
                            </span>
                        </td>
                        <td style="white-space: nowrap;">
                            <button class="btn-icon" title="Modifier" style="color: var(--primary);" onclick="openProductModal(${p.id ?? p.Id}, '${(p.name || p.Name).replace(/'/g, "\\'")}', '${(p.sku || p.sKU || p.SKU || '').replace(/'/g, "\\'")}', ${p.categoryId ?? p.CategoryId}, ${retail}, ${medium}, ${last}, ${p.minStockThreshold ?? p.MinStockThreshold}, ${p.currentStock ?? p.CurrentStock})"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button class="btn-icon" title="Supprimer" style="color: var(--danger); margin-left: 0.5rem;" onclick="deleteProduct(${p.id ?? p.Id})"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    </tr>
                `;
                }).join('');
                
            } catch (e) {
                console.error(e);
                tbody.innerHTML = '<tr><td colspan="7" class="text-center" style="color: var(--danger); padding: 2rem;">Erreur lors du chargement des données.</td></tr>';
            }
        }
        
        async function loadCategoryOptions(selectedId = null) {
            const token = localStorage.getItem("jwtToken");
            if (!token) return;
            try {
                const resp = await fetch('/api/categories', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (resp.ok) {
                    allProductCategories = await resp.json() || [];
                    renderCategorySelectOptions(allProductCategories, selectedId);
                }
            } catch(e) {
                console.error("Erreur chargement catégories pour le formulaire", e);
            }
        }

        async function initPage() {
            await loadCategoryOptions();
            await loadProducts();
        }
        
        document.addEventListener('DOMContentLoaded', initPage);
    </script>
}
