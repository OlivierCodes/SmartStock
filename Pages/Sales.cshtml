@page
@{
    ViewData["Title"] = "Ventes";
    Layout = "_DashboardLayout";
}

<div class="dashboard-header">
    <div class="dashboard-title">
        <h1>Historique des Ventes</h1>
        <p>Suivez les transactions et les tickets de caisse.</p>
    </div>
    <button class="btn-primary" onclick="loadSales()">
        <i class="fa-solid fa-rotate-right"></i>
        <span>Actualiser</span>
    </button>
</div>

<div class="glass-card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <h3 class="card-title" style="margin: 0;"><i class="fa-solid fa-receipt" style="color: var(--primary); margin-right: 8px;"></i>Transactions & Ventes</h3>
        
        <div style="display: flex; gap: 0.6rem; align-items: center; flex: 1; max-width: 750px; flex-wrap: wrap;">
            <div style="position: relative; flex: 2; min-width: 160px;">
                <input type="text" id="sales_search" placeholder="🔍 N° Vente, client, vendeur..." oninput="onSalesFilterChange()" style="width: 100%; padding-left: 2rem;">
                <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;"></i>
            </div>
            <div style="display: flex; align-items: center; gap: 0.3rem;">
                <label style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">Du</label>
                <input type="date" id="sales_from_date" onchange="onSalesFilterChange()" style="padding: 0.4rem 0.6rem; font-size: 0.85rem;">
            </div>
            <div style="display: flex; align-items: center; gap: 0.3rem;">
                <label style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">Au</label>
                <input type="date" id="sales_to_date" onchange="onSalesFilterChange()" style="padding: 0.4rem 0.6rem; font-size: 0.85rem;">
            </div>
            <div style="min-width: 120px;">
                <select id="sales_status_filter" onchange="onSalesFilterChange()" style="width: 100%; padding: 0.4rem 0.6rem; font-size: 0.85rem;">
                    <option value="">Tous statuts</option>
                    <option value="Completed">Complétée</option>
                    <option value="Cancelled">Annulée</option>
                </select>
            </div>
        </div>

        <button class="btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;" onclick="openSaleModal()">
            <i class="fa-solid fa-cart-plus"></i> Nouvelle Vente
        </button>
    </div>
    <div class="table-responsive">
        <table class="data-table" id="salesTable">
            <thead>
                <tr>
                    <th>N° Vente</th>
                    <th>Date</th>
                    <th>Vendeur</th>
                    <th>Montant Total</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="6" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement...</td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- Pagination -->
    <div class="pagination-container" id="salesPagination" style="display: none;">
        <div class="pagination-info" id="salesPaginationInfo"></div>
        <div class="pagination-controls" id="salesPaginationControls"></div>
    </div>
</div>

<!-- Modal Sale -->
<div class="modal-overlay" id="saleModal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h3 id="saleModalTitle">Nouvelle Vente</h3>
            <button class="modal-close" onclick="closeSaleModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div style="padding: 1.5rem; max-height: 80vh; overflow-y: auto;">
            <form id="saleForm" onsubmit="saveSale(event)">
                <div class="form-group">
                    <label>Nom du Client (Optionnel)</label>
                    <input type="text" id="s_customer" placeholder="Ex: Jean Dupont">
                </div>
                
                <div class="form-group">
                    <label>Ajouter un Produit</label>
                    <div style="margin-bottom: 0.5rem;">
                        <div style="position: relative;">
                            <input type="text" id="s_product_search" placeholder="🔍 Rechercher par nom ou SKU..." oninput="filterProductDropdown()" style="width: 100%; padding-left: 2rem;">
                            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;"></i>
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        <div>
                            <select id="s_product_select" onchange="onProductSelected()">
                                <option disabled selected value="">Sélectionner un produit...</option>
                            </select>
                        </div>
                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            <div style="flex: 2;">
                                <select id="s_price_type" onchange="onPriceTypeChanged()" style="width: 100%;">
                                    <option value="retail">Prix Détaillant</option>
                                    <option value="medium">Prix Moyen</option>
                                    <option value="last">Dernier Prix</option>
                                    <option value="custom">Prix Personnalisé</option>
                                </select>
                            </div>
                            <div style="flex: 1.5;">
                                <input type="number" step="0.01" id="s_unit_price" placeholder="P.U. (FCFA)">
                            </div>
                            <div style="width: 80px;">
                                <input type="number" id="s_product_qty" min="1" value="1" placeholder="Qté">
                            </div>
                            <button type="button" class="btn-primary" onclick="addToCart()" style="white-space: nowrap;">
                                <i class="fa-solid fa-plus"></i> Ajouter
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Panier</label>
                    <table class="data-table" style="margin-bottom: 0;">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th>Type Prix</th>
                                <th>P.U.</th>
                                <th>Qté</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cartTableBody">
                            <tr><td colspan="6" class="text-center" style="color: var(--text-muted); padding: 1rem;">Le panier est vide.</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- Alerte Décharge / Retrait Magasin -->
                <div id="withdrawalWarning" style="display: none; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.85rem; color: #f59e0b;">
                    <i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px; font-size: 1rem;"></i>
                    <strong>Information Prélèvement :</strong> Le stock rayon boutique étant insuffisant pour certains articles, un <strong>Bon de Retrait Magasin</strong> sera automatiquement généré pour vous permettre de récupérer les articles manquants en réserve.
                </div>

                <div class="form-group" style="text-align: right;">
                    <label>Montant Total (FCFA)</label>
                    <input type="number" step="0.01" id="s_total" readonly value="0.00" style="text-align: right; font-weight: bold; background: var(--bg-card); color: var(--text-primary);">
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-secondary" onclick="closeSaleModal()">Annuler</button>
                    <button type="submit" class="btn-primary">Valider la vente</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hidden Receipt Container for Printing -->
<div id="print-receipt-container" style="display: none;">
    <div class="receipt" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #000; max-width: 380px; margin: 0 auto; padding: 24px; background: #fff; line-height: 1.5;">
        
        <div style="text-align: center; margin-bottom: 20px;">
            <img id="r_shop_logo" src="" style="display:none; max-width: 120px; max-height: 120px; margin: 0 auto 12px; border-radius: 8px;">
            <h2 id="r_shop_name" style="margin: 0; font-size: 26px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #000;">SMART STOCK</h2>
            <p style="margin: 6px 0 0; font-size: 16px; font-weight: 600; color: #333; text-transform: uppercase; letter-spacing: 0.5px;">Ticket de Caisse</p>
        </div>
        
        <div style="border-top: 2px dashed #000; border-bottom: 2px dashed #000; padding: 12px 0; margin-bottom: 18px; font-size: 15px;">
            <table style="width: 100%; border-collapse: collapse; font-size: 15px;">
                <tr><td style="padding: 4px 0; font-weight: bold; width: 35%;">Date :</td><td style="text-align: right; font-weight: 500;" id="r_date"></td></tr>
                <tr><td style="padding: 4px 0; font-weight: bold;">Ticket N° :</td><td style="text-align: right; font-weight: bold; font-family: monospace; font-size: 16px;" id="r_number"></td></tr>
                <tr><td style="padding: 4px 0; font-weight: bold;">Vendeur :</td><td style="text-align: right; font-weight: 500;" id="r_seller"></td></tr>
                <tr id="r_customer_p" style="display: none;"><td style="padding: 4px 0; font-weight: bold;">Client :</td><td style="text-align: right; font-weight: bold;" id="r_customer"></td></tr>
            </table>
        </div>
        
        <table style="width: 100%; font-size: 15px; border-collapse: collapse; margin-bottom: 18px;">
            <thead>
                <tr style="border-bottom: 2px solid #000; font-size: 15px;">
                    <th style="text-align: left; padding: 8px 0; font-weight: bold;">Article</th>
                    <th style="text-align: center; padding: 8px 0; font-weight: bold; width: 60px;">Qté</th>
                    <th style="text-align: right; padding: 8px 0; font-weight: bold; width: 110px;">Montant</th>
                </tr>
            </thead>
            <tbody id="r_items">
            </tbody>
        </table>
        
        <div style="border-top: 2px solid #000; border-bottom: 2px solid #000; padding: 12px 0; margin-bottom: 25px;">
            <table style="width: 100%; font-size: 20px; font-weight: 800;">
                <tr>
                    <td style="text-transform: uppercase; letter-spacing: 0.5px;">TOTAL NET</td>
                    <td style="text-align: right;"><span id="r_total"></span> FCFA</td>
                </tr>
            </table>
        </div>
        
        <div style="text-align: center; font-size: 14px; color: #111; line-height: 1.6;">
            <p style="margin: 0 0 4px; font-weight: bold; font-size: 15px;">Merci de votre confiance !</p>
            <p style="margin: 0; font-style: italic;">À très bientôt chez SMART STOCK</p>
        </div>
        
    </div>
</div>

<!-- Conteneur d'impression du Bon de Retrait Magasin (affiché si prélèvement magasin nécessaire) -->
<div id="print-withdrawal-container" style="display: none;">
    <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #000; max-width: 480px; margin: 0 auto; padding: 24px; background: #fff; line-height: 1.5;">
        <div style="text-align: center; margin-bottom: 20px;">
            <h2 id="w_shop_name" style="margin: 0; font-size: 24px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #000;">SMART STOCK</h2>
            <p style="margin: 6px 0 0; font-size: 15px; font-weight: bold; color: #b91c1c; text-transform: uppercase; letter-spacing: 0.5px;">BON DE RETRAIT MAGASIN (RÉSERVE)</p>
            <p style="margin: 3px 0 0; font-size: 12px; color: #555;">À présenter au magasinier pour décharge suite à la vente</p>
        </div>
        <div style="border-top: 2px dashed #000; border-bottom: 2px dashed #000; padding: 12px 0; margin-bottom: 16px; font-size: 14px;">
            <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                <tr><td style="padding: 3px 0; font-weight: bold; width: 38%;">Vente Rattachée :</td><td style="text-align: right; font-weight: bold; font-family: monospace; font-size: 16px;" id="w_sale_number"></td></tr>
                <tr><td style="padding: 3px 0; font-weight: bold;">Date & Heure :</td><td style="text-align: right; font-weight: 500;" id="w_date"></td></tr>
                <tr><td style="padding: 3px 0; font-weight: bold;">Vendeur / Émetteur :</td><td style="text-align: right; font-weight: 600;" id="w_seller"></td></tr>
                <tr id="w_customer_p" style="display: none;"><td style="padding: 3px 0; font-weight: bold;">Client :</td><td style="text-align: right; font-weight: bold;" id="w_customer"></td></tr>
            </table>
        </div>
        <div style="background: rgba(239, 68, 68, 0.08); border: 2px solid #ef4444; padding: 10px; border-radius: 6px; margin-bottom: 16px; font-size: 13px;">
            <i class="fa-solid fa-triangle-exclamation" style="color: #dc2626; margin-right: 6px;"></i>
            <strong>Articles à retirer immédiatement au magasin :</strong>
        </div>
        <table style="width: 100%; font-size: 14px; border-collapse: collapse; margin-bottom: 18px;">
            <thead>
                <tr style="border-bottom: 2px solid #000; font-size: 14px;">
                    <th style="text-align: left; padding: 8px 0; font-weight: bold; width: 25%;">SKU</th>
                    <th style="text-align: left; padding: 8px 0; font-weight: bold;">Désignation</th>
                    <th style="text-align: right; padding: 8px 0; font-weight: bold; width: 25%;">Qté à Retirer</th>
                </tr>
            </thead>
            <tbody id="w_items"></tbody>
        </table>
        <div style="display: flex; gap: 0; margin-top: 24px; font-size: 12px;">
            <div style="flex: 1; border: 1px solid #000; border-right: none; padding: 10px; min-height: 65px;">
                <div style="font-weight: bold; font-size: 12px; margin-bottom: 4px;">Signature Magasinier</div>
                <div style="font-size: 10px; color: #666;">(Sortie de réserve)</div>
            </div>
            <div style="flex: 1; border: 1px solid #000; border-right: none; padding: 10px; min-height: 65px;">
                <div style="font-weight: bold; font-size: 12px; margin-bottom: 4px;">Signature Vendeur</div>
                <div style="font-size: 10px; color: #666;">(Demandeur)</div>
            </div>
            <div style="flex: 1; border: 1px solid #000; padding: 10px; min-height: 65px;">
                <div style="font-weight: bold; font-size: 12px; margin-bottom: 4px;">Signature / Décharge Client</div>
                <div style="font-size: 10px; color: #666;">(Réception article)</div>
            </div>
        </div>
        <div style="text-align: center; font-size: 12px; color: #444; margin-top: 20px;">
            <p style="margin: 0; font-style: italic;">Bon de retrait officiel pour régularisation de stock — SMART STOCK</p>
        </div>
    </div>
</div>

<style>
@@media print {
    body * {
        visibility: hidden;
    }
    #print-receipt-container, #print-receipt-container * {
        visibility: visible;
    }
    #print-withdrawal-container, #print-withdrawal-container * {
        visibility: visible;
    }
    #print-receipt-container {
        display: block !important;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 0;
        background: #fff;
    }
    #print-withdrawal-container {
        display: block !important;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 0;
        background: #fff;
    }
}
</style>

@section Scripts {
    <script>
        let cartItems = [];
        let allProducts = [];

        function renderProductOptions(productsToRender, selectedId = null) {
            const select = document.getElementById('s_product_select');
            if (!productsToRender || productsToRender.length === 0) {
                select.innerHTML = '<option disabled selected value="">Aucun produit correspondant</option>';
                return;
            }

            select.innerHTML = '<option disabled selected value="">Sélectionner un produit...</option>' + productsToRender.map(p => {
                const retail = p.retailPrice ?? p.RetailPrice ?? p.sellingPrice ?? p.SellingPrice ?? 0;
                const medium = p.mediumPrice ?? p.MediumPrice ?? retail;
                const last = p.lastPrice ?? p.LastPrice ?? medium;
                const shop = p.shopStock ?? p.ShopStock ?? 0;
                const warehouse = p.warehouseStock ?? p.WarehouseStock ?? 0;
                return `<option value="${p.id ?? p.Id}" data-retail="${retail}" data-medium="${medium}" data-last="${last}" data-shop="${shop}" data-warehouse="${warehouse}">[${p.sku || p.sKU || p.SKU || 'N/A'}] ${p.name || p.Name} (Boutique: ${shop} | Magasin: ${warehouse}) - Détaillant: ${retail.toFixed(2)} FCFA</option>`;
            }).join('');

            if (selectedId) {
                select.value = selectedId;
                onProductSelected();
            } else if (productsToRender.length === 1) {
                select.value = productsToRender[0].id ?? productsToRender[0].Id;
                onProductSelected();
            }
        }

        function onProductSelected() {
            const select = document.getElementById('s_product_select');
            const selectedOption = select.options[select.selectedIndex];
            if (!selectedOption || !selectedOption.dataset) return;

            onPriceTypeChanged();
        }

        function onPriceTypeChanged() {
            const select = document.getElementById('s_product_select');
            const selectedOption = select.options[select.selectedIndex];
            if (!selectedOption || !selectedOption.dataset) return;

            const type = document.getElementById('s_price_type').value;
            const unitPriceInput = document.getElementById('s_unit_price');
            const retail = parseFloat(selectedOption.dataset.retail) || 0;
            const medium = parseFloat(selectedOption.dataset.medium) || retail;
            const last = parseFloat(selectedOption.dataset.last) || medium;

            if (type === 'retail') {
                unitPriceInput.value = retail.toFixed(2);
                unitPriceInput.readOnly = true;
            } else if (type === 'medium') {
                unitPriceInput.value = medium.toFixed(2);
                unitPriceInput.readOnly = true;
            } else if (type === 'last') {
                unitPriceInput.value = last.toFixed(2);
                unitPriceInput.readOnly = true;
            } else {
                unitPriceInput.readOnly = false;
                unitPriceInput.focus();
            }
        }

        function filterProductDropdown() {
            const query = (document.getElementById('s_product_search').value || '').trim().toLowerCase();
            if (!query) {
                renderProductOptions(allProducts);
                return;
            }

            const filtered = allProducts.filter(p => {
                const name = (p.name || p.Name || '').toLowerCase();
                const sku = (p.sku || p.sKU || p.SKU || '').toLowerCase();
                const cat = (p.categoryName || p.CategoryName || '').toLowerCase();
                return name.includes(query) || sku.includes(query) || cat.includes(query);
            });

            renderProductOptions(filtered);
        }

        async function openSaleModal() {
            document.getElementById('saleForm').reset();
            const searchInput = document.getElementById('s_product_search');
            if (searchInput) searchInput.value = '';
            cartItems = [];
            updateCartUI();
            const select = document.getElementById('s_product_select');
            select.innerHTML = '<option disabled selected value="">Chargement...</option>';
            document.getElementById('s_unit_price').value = '';
            document.getElementById('s_price_type').value = 'retail';
            document.getElementById('saleModal').classList.add('show');
            
            try {
                const token = localStorage.getItem("jwtToken");
                const resp = await fetch('/api/products?pageNumber=1&pageSize=500', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if(resp.ok) {
                    const result = await resp.json();
                    allProducts = result.items || result;
                    renderProductOptions(allProducts);
                }
            } catch(e) {
                console.error("Impossible de charger les produits");
            }
        }

        function addToCart() {
            const select = document.getElementById('s_product_select');
            const qtyInput = document.getElementById('s_product_qty');
            const unitPriceInput = document.getElementById('s_unit_price');
            const priceTypeSelect = document.getElementById('s_price_type');
            
            const productId = parseInt(select.value);
            const qty = parseInt(qtyInput.value);
            const unitPrice = parseFloat(unitPriceInput.value);
            
            if (!productId || isNaN(qty) || qty <= 0) {
                showToast("Veuillez sélectionner un produit et une quantité valide", "warning");
                return;
            }

            if (isNaN(unitPrice) || unitPrice < 0) {
                showToast("Veuillez renseigner un prix unitaire valide", "warning");
                return;
            }
            
            const product = allProducts.find(p => (p.id ?? p.Id) === productId);
            if (!product) return;

            const shop = product.shopStock ?? product.ShopStock ?? 0;
            const warehouse = product.warehouseStock ?? product.WarehouseStock ?? 0;
            const totalAvailable = shop + warehouse;

            if (qty > totalAvailable) {
                showToast(`Stock insuffisant pour "${product.name || product.Name}". Boutique: ${shop} + Magasin: ${warehouse} = ${totalAvailable} disponible.`, "danger");
                return;
            }

            const priceTypeLabel = priceTypeSelect.options[priceTypeSelect.selectedIndex].text;
            const sku = product.sku || product.sKU || product.SKU || 'N/A';
            
            // Calculer quelle portion vient du magasin (réserve)
            const fromShop = Math.min(shop, qty);
            const fromWarehouse = qty - fromShop;

            const existingIndex = cartItems.findIndex(i => i.productId === productId && i.price === unitPrice);
            if (existingIndex !== -1) {
                cartItems[existingIndex].quantity += qty;
                cartItems[existingIndex].fromWarehouse = (cartItems[existingIndex].fromWarehouse || 0) + fromWarehouse;
            } else {
                cartItems.push({
                    productId: productId,
                    name: product.name || product.Name,
                    sku: sku,
                    priceType: priceTypeLabel,
                    price: unitPrice,
                    quantity: qty,
                    shopStock: shop,
                    warehouseStock: warehouse,
                    fromWarehouse: fromWarehouse   // quantité à prélever en réserve magasin
                });
            }
            
            // Reset fields
            select.value = '';
            qtyInput.value = 1;
            unitPriceInput.value = '';
            priceTypeSelect.value = 'retail';
            
            updateCartUI();
        }

        function removeFromCart(index) {
            cartItems.splice(index, 1);
            updateCartUI();
        }

        function updateCartUI() {
            const tbody = document.getElementById('cartTableBody');
            const totalInput = document.getElementById('s_total');
            const warningBox = document.getElementById('withdrawalWarning');
            
            if (cartItems.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color: var(--text-muted); padding: 1rem;">Le panier est vide.</td></tr>';
                totalInput.value = "0.00";
                if (warningBox) warningBox.style.display = 'none';
                return;
            }
            
            let total = 0;
            let needsWarehouseWithdrawal = false;

            tbody.innerHTML = cartItems.map((item, idx) => {
                const lineTotal = item.price * item.quantity;
                total += lineTotal;
                const fromWh = item.fromWarehouse || 0;
                if (fromWh > 0) needsWarehouseWithdrawal = true;
                
                const stockBadge = fromWh > 0
                    ? `<span class="badge" style="background: rgba(245,158,11,0.2); color: #f59e0b; font-size: 0.7rem; margin-left: 4px;" title="${fromWh} unité(s) depuis la réserve magasin">
                           <i class="fa-solid fa-warehouse"></i> +${fromWh} mag.
                       </span>`
                    : '';

                return `
                    <tr>
                        <td>${item.name}${stockBadge}</td>
                        <td><span class="badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; font-size: 0.75rem;">${item.priceType || 'Détaillant'}</span></td>
                        <td>${item.price.toFixed(2)} FCFA</td>
                        <td>${item.quantity}</td>
                        <td style="font-weight: bold;">${lineTotal.toFixed(2)} FCFA</td>
                        <td style="text-align: right;"><button type="button" class="btn-icon" style="color: var(--danger); font-size: 0.9rem;" onclick="removeFromCart(${idx})"><i class="fa-solid fa-xmark"></i></button></td>
                    </tr>
                `;
            }).join('');
            
            totalInput.value = total.toFixed(2);

            // Afficher ou masquer l'avertissement de prélèvement magasin
            if (warningBox) {
                warningBox.style.display = needsWarehouseWithdrawal ? 'block' : 'none';
            }
        }

        function closeSaleModal() {
            document.getElementById('saleModal').classList.remove('show');
        }

        async function saveSale(e) {
            e.preventDefault();
            const token = localStorage.getItem("jwtToken");
            if (!token) return;

            const customerName = document.getElementById('s_customer').value;
            
            if (cartItems.length === 0) {
                showToast("Veuillez ajouter au moins un produit au panier", "warning");
                return;
            }

            const items = cartItems.map(i => ({
                productId: i.productId,
                quantity: i.quantity,
                unitPrice: i.price
            }));

            // Identifier les articles nécessitant un retrait du magasin
            const warehouseItems = cartItems
                .filter(i => (i.fromWarehouse || 0) > 0)
                .map(i => ({
                    name: i.name,
                    sku: i.sku || 'N/A',
                    fromWarehouse: i.fromWarehouse
                }));

            const requestBody = {
                customerName: customerName,
                notes: "",
                items: items
            };

            try {
                const resp = await fetch('/api/sales', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(requestBody)
                });

                if (!resp.ok) {
                    const errText = await resp.text();
                    let errMsg = errText;
                    try {
                        const errJson = JSON.parse(errText);
                        if (errJson.message) errMsg = errJson.message;
                    } catch (e) { }
                    throw new Error(errMsg);
                }
                
                const saleData = await resp.json();
                
                closeSaleModal();
                showToast('Vente enregistrée avec succès', 'success');
                loadSales();
                
                // Imprimer le reçu de vente en premier
                await printReceipt(saleData);

                // Si certains articles venaient du stock magasin, imprimer le bon de retrait
                if (warehouseItems.length > 0) {
                    setTimeout(() => {
                        printWithdrawalSlip(saleData, warehouseItems);
                    }, 800);
                }
                
            } catch (error) {
                console.error(error);
                showToast("Erreur: " + error.message, "danger");
            }
        }

        async function printWithdrawalSlip(sale, warehouseItems) {
            try {
                const resp = await fetch('/api/settings');
                if (resp.ok) {
                    const data = await resp.json();
                    if (data.shopName) {
                        document.getElementById('w_shop_name').innerText = data.shopName;
                    }
                }
            } catch (e) { /* ignore */ }

            document.getElementById('w_sale_number').innerText = sale.saleNumber || sale.SaleNumber || '—';
            document.getElementById('w_date').innerText = new Date(sale.soldAt || sale.SoldAt || Date.now()).toLocaleString('fr-FR');
            document.getElementById('w_seller').innerText = sale.sellerName || sale.SellerName || '—';

            const customer = sale.customerName || sale.CustomerName;
            if (customer) {
                document.getElementById('w_customer_p').style.display = 'table-row';
                document.getElementById('w_customer').innerText = customer;
            } else {
                document.getElementById('w_customer_p').style.display = 'none';
            }

            document.getElementById('w_items').innerHTML = warehouseItems.map(item => `
                <tr>
                    <td style="padding: 8px 0; border-bottom: 1px solid #ddd; font-weight: 600; font-size: 14px; color: #000;">${item.sku}</td>
                    <td style="padding: 8px 0; border-bottom: 1px solid #ddd; font-weight: 600; font-size: 14px; color: #000;">${item.name}</td>
                    <td style="text-align: right; padding: 8px 0; border-bottom: 1px solid #ddd; font-weight: 800; font-size: 16px; color: #dc2626;">${item.fromWarehouse}</td>
                </tr>
            `).join('');

            document.getElementById('print-withdrawal-container').style.display = 'block';
            window.print();
            document.getElementById('print-withdrawal-container').style.display = 'none';
        }
        
        async function printReceipt(sale) {
            try {
                const resp = await fetch('/api/settings');
                if (resp.ok) {
                    const data = await resp.json();
                    if (data.shopName) {
                        document.getElementById('r_shop_name').innerText = data.shopName;
                    }
                    if (data.logoBase64) {
                        const logoEl = document.getElementById('r_shop_logo');
                        if (logoEl) {
                            logoEl.src = data.logoBase64;
                            logoEl.style.display = 'inline-block';
                        }
                    }
                }
            } catch (e) { console.error('Settings load failed for receipt', e); }

            document.getElementById('r_date').innerText = new Date(sale.soldAt || sale.SoldAt).toLocaleString();
            document.getElementById('r_number').innerText = sale.saleNumber || sale.SaleNumber;
            document.getElementById('r_seller').innerText = sale.sellerName || sale.SellerName || 'N/A';
            
            const customer = sale.customerName || sale.CustomerName;
            if (customer) {
                document.getElementById('r_customer_p').style.display = 'block';
                document.getElementById('r_customer').innerText = customer;
            } else {
                document.getElementById('r_customer_p').style.display = 'none';
            }
            
            const items = sale.items || sale.Items || [];
            document.getElementById('r_items').innerHTML = items.map(i => `
                <tr>
                    <td style="padding: 8px 0; border-bottom: 1px solid #ddd; font-weight: 600; font-size: 15px; color: #000;">${i.productName || i.ProductName}</td>
                    <td style="text-align: center; padding: 8px 0; border-bottom: 1px solid #ddd; font-weight: bold; font-size: 15px; color: #000;">${i.quantity || i.Quantity}</td>
                    <td style="text-align: right; padding: 8px 0; border-bottom: 1px solid #ddd; font-weight: bold; font-size: 15px; color: #000;">${(i.totalPrice || i.TotalPrice).toFixed(2)}</td>
                </tr>
            `).join('');
            
            document.getElementById('r_total').innerText = (sale.totalAmount || sale.TotalAmount).toFixed(2);
            
            document.getElementById('print-receipt-container').style.display = 'block';
            window.print();
            document.getElementById('print-receipt-container').style.display = 'none';
        }

        function viewSale(saleNumber) {
            showToast('Détails de la vente ' + saleNumber, 'success');
        }

        async function reprintSale(id) {
            const token = localStorage.getItem("jwtToken");
            try {
                const resp = await fetch('/api/sales/' + id, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!resp.ok) throw new Error('Erreur de chargement');
                const saleData = await resp.json();
                printReceipt(saleData);
            } catch (e) {
                console.error(e);
                showToast("Erreur lors de la récupération de la vente: " + e.message, "danger");
            }
        }

        function cancelSale(id) {
            showConfirmModal("Voulez-vous annuler cette vente ? Le stock sera restauré.", async () => {
                const token = localStorage.getItem("jwtToken");
                try {
                    const resp = await fetch('/api/sales/' + id + '/cancel', {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (!resp.ok) {
                        const errText = await resp.text();
                        let errMsg = errText;
                        try {
                            const errJson = JSON.parse(errText);
                            if (errJson.message) errMsg = errJson.message;
                        } catch (e) { }
                        throw new Error(errMsg);
                    }
                    
                    showToast('Vente annulée avec succès', 'success');
                    loadSales();
                } catch(e) {
                    showToast("Erreur: " + e.message, "danger");
                }
            });
        }

        let currentSalesPage = 1;
        const salesPageSize = 20;
        let salesFilterDebounce = null;

        function onSalesFilterChange() {
            clearTimeout(salesFilterDebounce);
            salesFilterDebounce = setTimeout(() => {
                currentSalesPage = 1;
                loadSales();
            }, 300);
        }

        function changeSalesPage(page) {
            currentSalesPage = page;
            loadSales();
        }

        function renderSalesPagination(page, totalPages, totalCount) {
            const container = document.getElementById('salesPagination');
            const infoEl = document.getElementById('salesPaginationInfo');
            const controlsEl = document.getElementById('salesPaginationControls');

            if (!totalPages || totalPages <= 1) {
                container.style.display = totalCount > 0 ? 'flex' : 'none';
                infoEl.innerText = `${totalCount} transaction(s) au total`;
                controlsEl.innerHTML = '';
                return;
            }

            container.style.display = 'flex';
            const from = (page - 1) * salesPageSize + 1;
            const to = Math.min(page * salesPageSize, totalCount);
            infoEl.innerText = `Affichage de ${from} à ${to} sur ${totalCount} ventes`;

            let html = '';
            // Bouton Précédent
            html += `<button class="pagination-btn" ${page <= 1 ? 'disabled' : ''} onclick="changeSalesPage(${page - 1})" title="Page précédente"><i class="fa-solid fa-chevron-left"></i></button>`;

            // Pages numérotées avec ellipses intelligentes
            const maxVisible = 5;
            let startPage = Math.max(1, page - 2);
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage < maxVisible - 1) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }

            if (startPage > 1) {
                html += `<button class="pagination-btn" onclick="changeSalesPage(1)">1</button>`;
                if (startPage > 2) html += `<span class="pagination-ellipsis">...</span>`;
            }

            for (let i = startPage; i <= endPage; i++) {
                html += `<button class="pagination-btn ${i === page ? 'active' : ''}" onclick="changeSalesPage(${i})">${i}</button>`;
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) html += `<span class="pagination-ellipsis">...</span>`;
                html += `<button class="pagination-btn" onclick="changeSalesPage(${totalPages})">${totalPages}</button>`;
            }

            // Bouton Suivant
            html += `<button class="pagination-btn" ${page >= totalPages ? 'disabled' : ''} onclick="changeSalesPage(${page + 1})" title="Page suivante"><i class="fa-solid fa-chevron-right"></i></button>`;

            controlsEl.innerHTML = html;
        }

        async function loadSales() {
            const token = localStorage.getItem("jwtToken");
            if (!token) {
                window.location.href = "/Login";
                return;
            }
            
            const tbody = document.querySelector('#salesTable tbody');
            tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement...</td></tr>';
            
            try {
                let isVendor = false;
                try {
                    const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
                    const role = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"];
                    if (role === 'Vendeur') isVendor = true;
                } catch(e) {}

                const baseUrl = isVendor ? '/api/sales/my-sales' : '/api/sales';
                const params = new URLSearchParams({
                    page: currentSalesPage,
                    pageSize: salesPageSize
                });

                const fromDate = document.getElementById('sales_from_date')?.value;
                const toDate = document.getElementById('sales_to_date')?.value;
                const status = document.getElementById('sales_status_filter')?.value;
                const search = (document.getElementById('sales_search')?.value || '').trim().toLowerCase();

                if (fromDate) params.append('from', fromDate);
                if (toDate) params.append('to', toDate);
                if (status) params.append('status', status);

                const resp = await fetch(`${baseUrl}?${params.toString()}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (resp.status === 401) {
                    window.location.href = "/Login";
                    return;
                }
                if (!resp.ok) throw new Error('Erreur API');
                
                const result = await resp.json();
                let sales = result.items || result || [];
                const totalCount = result.totalCount ?? sales.length;
                const totalPages = result.totalPages ?? Math.ceil(totalCount / salesPageSize);

                // Filtrage client supplémentaire si recherche texte présente
                if (search) {
                    sales = sales.filter(s => {
                        const num = (s.saleNumber || '').toLowerCase();
                        const seller = (s.sellerName || '').toLowerCase();
                        const client = (s.customerName || '').toLowerCase();
                        return num.includes(search) || seller.includes(search) || client.includes(search);
                    });
                }
                
                if (!sales || sales.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color: var(--text-muted); padding: 2rem;">Aucune vente trouvée.</td></tr>';
                    renderSalesPagination(currentSalesPage, 0, 0);
                    return;
                }
                
                tbody.innerHTML = sales.map(s => `
                    <tr>
                        <td style="font-weight: 500;">${s.saleNumber}</td>
                        <td>${new Date(s.soldAt).toLocaleString()}</td>
                        <td>${s.sellerName || '-'}</td>
                        <td style="font-weight: 600; color: var(--text-primary);">${s.totalAmount.toFixed(2)} FCFA</td>
                        <td>
                            <span class="badge" style="background: ${s.status === 'Completed' ? 'rgba(34, 197, 94, 0.2)' : 'rgba(239, 68, 68, 0.2)'}; color: ${s.status === 'Completed' ? 'var(--success)' : 'var(--danger)'};">
                                ${s.status}
                            </span>
                        </td>
                        <td style="white-space: nowrap;">
                            <button class="btn-icon" title="Voir le détail" style="color: var(--primary);" onclick="viewSale('${s.saleNumber}')"><i class="fa-solid fa-eye"></i></button>
                            ${s.status === 'Completed' ? `<button class="btn-icon" title="Annuler la vente" style="color: var(--danger); margin-left: 0.5rem;" onclick="cancelSale(${s.id})"><i class="fa-solid fa-ban"></i></button>` : ''}
                            <button class="btn-icon" title="Imprimer le reçu" style="color: var(--text-muted); margin-left: 0.5rem;" onclick="reprintSale(${s.id})"><i class="fa-solid fa-print"></i></button>
                        </td>
                    </tr>
                `).join('');

                renderSalesPagination(currentSalesPage, totalPages, totalCount);
                
            } catch (e) {
                console.error(e);
                tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color: var(--danger); padding: 2rem;">Erreur lors du chargement des données.</td></tr>';
            }
        }
        
        document.addEventListener('DOMContentLoaded', loadSales);
    </script>
}
