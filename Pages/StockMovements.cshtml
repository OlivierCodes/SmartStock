@page
@{
    ViewData["Title"] = "Mouvements de Stock";
    Layout = "_DashboardLayout";
}

<div class="dashboard-header">
    <div class="dashboard-title">
        <h1>Mouvements de Stock</h1>
        <p>Entrées magasin, sorties, et transferts Magasin → Boutique.</p>
    </div>
    <div style="display:flex; gap:0.75rem;">
        <button class="btn-secondary" onclick="openTransferModal()" style="padding:0.6rem 1.1rem; font-size:0.9rem; border-radius:8px;">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> Prélèvement Magasin → Boutique
        </button>
        <button class="btn-primary" onclick="openMovementModal()">
            <i class="fa-solid fa-arrow-right-arrow-left"></i> Nouveau Mouvement
        </button>
    </div>
</div>

<!-- Stock Summary Cards -->
<div id="stockSummaryCards" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap:1rem; margin-bottom:1.5rem; display:none;"></div>

<div class="glass-card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 class="card-title">Historique des Mouvements</h3>
        <button class="btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;" onclick="loadMovements()">
            <i class="fa-solid fa-rotate-right"></i> Actualiser
        </button>
    </div>
    <div class="table-responsive">
        <table class="data-table" id="movementsTable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Produit</th>
                    <th>Quantité</th>
                    <th>Stock Total Après</th>
                    <th>Raison / Référence</th>
                    <th>Délégué</th>
                    <th>Utilisateur</th>
                    <th style="text-align: center;">Bon</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Entrée / Sortie Standard -->
<div class="modal-overlay" id="movementModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fa-solid fa-arrow-right-arrow-left"></i> Nouveau Mouvement</h3>
            <button class="modal-close" onclick="closeModal('movementModal')"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="movementForm" onsubmit="saveMovement(event)">
            <div class="form-group">
                <label>Produit</label>
                <select id="m_product" required>
                    <option disabled selected>Chargement...</option>
                </select>
                <small id="m_stockInfo" style="color: var(--text-muted); margin-top:4px; display:block;"></small>
            </div>
            <div class="form-group" style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <label>Type de Mouvement</label>
                    <select id="m_type" required>
                        <option value="0">📦 Entrée Magasin (+)</option>
                        <option value="1">🔻 Sortie / Perte (-)</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label>Quantité</label>
                    <input type="number" id="m_quantity" required min="1" value="1">
                </div>
            </div>
            <div class="form-group">
                <label>Raison</label>
                <input type="text" id="m_reason" placeholder="Ex: Réapprovisionnement fournisseur">
            </div>
            <div class="form-group">
                <label>Référence</label>
                <input type="text" id="m_reference" placeholder="Ex: BL-2026-0042">
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeModal('movementModal')">Annuler</button>
                <button type="submit" class="btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Transfert Magasin → Boutique (Prélèvement) -->
<div class="modal-overlay" id="transferModal">
    <div class="modal-content">
        <div class="modal-header" style="background: linear-gradient(135deg, rgba(139,92,246,0.15), rgba(59,130,246,0.1)); border-radius:8px 8px 0 0; padding:1rem 1.25rem;">
            <h3><i class="fa-solid fa-truck-fast" style="color: var(--primary);"></i> Prélèvement Magasin → Boutique</h3>
            <button class="modal-close" onclick="closeModal('transferModal')"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="transferForm" onsubmit="saveTransfer(event)">
            <div class="form-group" style="margin-top:1rem;">
                <label>Produit à prélever</label>
                <select id="t_product" required onchange="onTransferProductChange(this)">
                    <option disabled selected>Chargement...</option>
                </select>
            </div>
            <!-- Infos stock actuel -->
            <div id="t_stockInfo" style="display:none; margin-bottom:1rem; padding:0.75rem 1rem; border-radius:8px; background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.2);">
                <div style="display:flex; gap:1.5rem; font-size:0.9rem;">
                    <div><i class="fa-solid fa-warehouse" style="color:#8b5cf6; margin-right:5px;"></i><strong>Magasin : </strong><span id="t_warehouseQty" style="font-weight:700; color:#8b5cf6;">-</span></div>
                    <div><i class="fa-solid fa-store" style="color:#3b82f6; margin-right:5px;"></i><strong>Boutique : </strong><span id="t_shopQty" style="font-weight:700; color:#3b82f6;">-</span></div>
                </div>
            </div>
            <div class="form-group" style="display:flex; gap:1rem;">
                <div style="flex:1;">
                    <label>Quantité à prélever</label>
                    <input type="number" id="t_quantity" required min="1" value="1">
                </div>
            </div>
            <div class="form-group">
                <label><i class="fa-solid fa-user" style="color:var(--primary); margin-right:5px;"></i>Personne déléguée (coursier / employé)</label>
                <input type="text" id="t_delegate" placeholder="Ex: Jean-Pierre, Vendeur Salle A" required>
            </div>
            <div class="form-group">
                <label>Raison / Note</label>
                <input type="text" id="t_reason" placeholder="Ex: Réapprovisionnement urgent boutique">
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeModal('transferModal')">Annuler</button>
                <button type="submit" class="btn-primary" style="background: linear-gradient(135deg, #8b5cf6, #3b82f6);">
                    <i class="fa-solid fa-truck-fast"></i> Valider le Prélèvement
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Conteneur d'impression du bon de prélèvement -->
<div id="print-transfer-container" style="display: none;">
    <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #000; max-width: 480px; margin: 0 auto; padding: 24px; background: #fff; line-height: 1.5;">
        <div style="text-align: center; margin-bottom: 20px;">
            <h2 id="tr_shop_name" style="margin: 0; font-size: 24px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #000;">SMART STOCK</h2>
            <p style="margin: 6px 0 0; font-size: 15px; font-weight: bold; color: #333; text-transform: uppercase; letter-spacing: 0.5px;">BON DE PRÉLÈVEMENT — TRANSFERT INTERNE</p>
        </div>
        <div style="border-top: 2px dashed #000; border-bottom: 2px dashed #000; padding: 12px 0; margin-bottom: 16px; font-size: 14px;">
            <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                <tr><td style="padding: 3px 0; font-weight: bold; width: 35%;">N° Bon :</td><td style="text-align: right; font-weight: bold; font-family: monospace; font-size: 16px;" id="tr_bon_number"></td></tr>
                <tr><td style="padding: 3px 0; font-weight: bold;">Date & Heure :</td><td style="text-align: right; font-weight: 500;" id="tr_date"></td></tr>
                <tr><td style="padding: 3px 0; font-weight: bold;">Émis par :</td><td style="text-align: right; font-weight: 600;" id="tr_user"></td></tr>
            </table>
        </div>
        <div style="display: flex; gap: 0; margin-bottom: 16px; font-size: 14px;">
            <div style="flex: 1; padding: 10px; border: 2px solid #000; border-right: none; background: #fafafa;">
                <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #555; margin-bottom: 4px;">Provenance</div>
                <div style="font-weight: 800; font-size: 15px;">Magasin (Réserve)</div>
            </div>
            <div style="flex: 1; padding: 10px; border: 2px solid #000; background: #fafafa;">
                <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #555; margin-bottom: 4px;">Destination</div>
                <div style="font-weight: 800; font-size: 15px;">Boutique (Rayon)</div>
            </div>
        </div>
        <div style="margin-bottom: 16px; padding: 10px; border: 2px solid #000; font-size: 14px; background: #fafafa;">
            <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #555; margin-bottom: 4px;">Personne Déléguée (Coursier)</div>
            <div id="tr_delegate" style="font-size: 16px; font-weight: 800; color: #000;"></div>
        </div>
        <table style="width: 100%; font-size: 14px; border-collapse: collapse; margin-bottom: 18px;">
            <thead>
                <tr style="border-bottom: 2px solid #000; font-size: 14px;">
                    <th style="text-align: left; padding: 8px 0; font-weight: bold; width: 25%;">SKU</th>
                    <th style="text-align: left; padding: 8px 0; font-weight: bold;">Désignation</th>
                    <th style="text-align: right; padding: 8px 0; font-weight: bold; width: 25%;">Qté Prélevée</th>
                </tr>
            </thead>
            <tbody id="tr_items"></tbody>
        </table>
        <div style="border-top: 2px dashed #000; margin-bottom: 16px; padding-top: 10px; font-size: 14px;" id="tr_reason_block"></div>
        <div style="display: flex; gap: 0; margin-top: 24px; font-size: 12px;">
            <div style="flex: 1; border: 1px solid #000; border-right: none; padding: 10px; min-height: 65px;">
                <div style="font-weight: bold; font-size: 12px; margin-bottom: 4px;">Signature Magasinier</div>
            </div>
            <div style="flex: 1; border: 1px solid #000; border-right: none; padding: 10px; min-height: 65px;">
                <div style="font-weight: bold; font-size: 12px; margin-bottom: 4px;">Signature Délégué</div>
            </div>
            <div style="flex: 1; border: 1px solid #000; padding: 10px; min-height: 65px;">
                <div style="font-weight: bold; font-size: 12px; margin-bottom: 4px;">Signature Réception</div>
            </div>
        </div>
        <div style="text-align: center; font-size: 12px; color: #444; margin-top: 20px;">
            <p style="margin: 0; font-style: italic;">Document officiel de décharge interne — SMART STOCK</p>
        </div>
    </div>
</div>

<style>
@@media print {
    body * { visibility: hidden; }
    #print-transfer-container, #print-transfer-container * { visibility: visible; }
    #print-transfer-container {
        display: block !important;
        position: absolute;
        left: 0; top: 0;
        width: 100%; margin: 0; padding: 0;
        background: #fff;
    }
}
</style>

@section Scripts {
    <script>
        let allProducts = [];

        function closeModal(id) {
            document.getElementById(id).classList.remove('show');
        }

        async function loadProducts() {
            const token = localStorage.getItem("jwtToken");
            const resp = await fetch('/api/products?pageNumber=1&pageSize=200', {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            if (resp.ok) {
                const result = await resp.json();
                allProducts = result.items || result;
            }
            return allProducts;
        }

        async function openMovementModal() {
            document.getElementById('movementForm').reset();
            document.getElementById('m_stockInfo').textContent = '';
            document.getElementById('movementModal').classList.add('show');
            const products = await loadProducts();
            const sel = document.getElementById('m_product');
            sel.innerHTML = products.map(p =>
                `<option value="${p.id}" data-shop="${p.shopStock}" data-warehouse="${p.warehouseStock}">[${p.sku || 'N/A'}] ${p.name}</option>`
            ).join('');
            sel.addEventListener('change', () => {
                const opt = sel.selectedOptions[0];
                document.getElementById('m_stockInfo').textContent =
                    `Boutique: ${opt.dataset.shop} | Magasin: ${opt.dataset.warehouse}`;
            });
            if (sel.options.length) sel.dispatchEvent(new Event('change'));
        }

        async function openTransferModal() {
            document.getElementById('transferForm').reset();
            document.getElementById('t_stockInfo').style.display = 'none';
            document.getElementById('transferModal').classList.add('show');
            const products = await loadProducts();
            const sel = document.getElementById('t_product');
            sel.innerHTML = `<option disabled selected>-- Sélectionner un produit --</option>` +
                products.map(p =>
                    `<option value="${p.id}" data-shop="${p.shopStock}" data-warehouse="${p.warehouseStock}">[${p.sku || 'N/A'}] ${p.name}</option>`
                ).join('');
        }

        function onTransferProductChange(sel) {
            const opt = sel.selectedOptions[0];
            if (!opt || !opt.dataset.warehouse) return;
            document.getElementById('t_warehouseQty').textContent = opt.dataset.warehouse;
            document.getElementById('t_shopQty').textContent = opt.dataset.shop;
            document.getElementById('t_stockInfo').style.display = 'block';
        }

        async function saveMovement(e) {
            e.preventDefault();
            const token = localStorage.getItem("jwtToken");
            const body = {
                productId: parseInt(document.getElementById('m_product').value),
                type: parseInt(document.getElementById('m_type').value),
                quantity: parseInt(document.getElementById('m_quantity').value),
                reason: document.getElementById('m_reason').value || null,
                reference: document.getElementById('m_reference').value || null
            };
            try {
                const resp = await fetch('/api/stockMovements', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(body)
                });
                if (!resp.ok) { const err = await resp.json(); throw new Error(err.message || 'Erreur'); }
                closeModal('movementModal');
                showToast('Mouvement enregistré avec succès', 'success');
                loadMovements();
            } catch (err) {
                showToast('Erreur: ' + err.message, 'danger');
            }
        }

        async function saveTransfer(e) {
            e.preventDefault();
            const token = localStorage.getItem("jwtToken");
            const body = {
                productId: parseInt(document.getElementById('t_product').value),
                type: 2, // TransfertBoutique
                quantity: parseInt(document.getElementById('t_quantity').value),
                reason: document.getElementById('t_reason').value || 'Prélèvement boutique',
                delegatePerson: document.getElementById('t_delegate').value
            };
            try {
                const resp = await fetch('/api/stockMovements', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(body)
                });
                if (!resp.ok) { const err = await resp.json(); throw new Error(err.message || 'Erreur'); }
                const movement = await resp.json();
                closeModal('transferModal');
                showToast('Prélèvement validé ! Impression du bon en cours...', 'success');
                loadMovements();
                // Imprimer le bon de prélèvement
                await printTransferReceipt(movement);
            } catch (err) {
                showToast('Erreur: ' + err.message, 'danger');
            }
        }

        async function printTransferReceipt(movement) {
            try {
                try {
                    const resp = await fetch('/api/settings');
                    if (resp.ok) {
                        const data = await resp.json();
                        if (data.shopName) {
                            document.getElementById('tr_shop_name').innerText = data.shopName;
                        }
                    }
                } catch (e) { console.error('Settings load failed for transfer receipt', e); }

                const bonId = movement.id ? String(movement.id).padStart(4, '0') : 'N/A';
                document.getElementById('tr_bon_number').innerText = `BP-${bonId}`;
                document.getElementById('tr_date').innerText = new Date(movement.createdAt || new Date()).toLocaleString();
                document.getElementById('tr_user').innerText = movement.createdByName || 'Gestionnaire';
                document.getElementById('tr_delegate').innerText = movement.delegatePerson || document.getElementById('t_delegate')?.value || 'N/A';

                const pName = movement.productName || 'Article';
                const pSku = movement.productSku || '-';
                const pQty = movement.quantity || 1;

                document.getElementById('tr_items').innerHTML = `
                    <tr>
                        <td style="padding: 8px 0; border-bottom: 1px solid #ddd; font-family: monospace; font-size: 14px; font-weight: bold; color: #000;">${pSku}</td>
                        <td style="padding: 8px 0; border-bottom: 1px solid #ddd; font-size: 15px; font-weight: 600; color: #000;">${pName}</td>
                        <td style="text-align: right; padding: 8px 0; border-bottom: 1px solid #ddd; font-weight: 800; font-size: 16px; color: #000;">${pQty}</td>
                    </tr>
                `;

                const reason = movement.reason || document.getElementById('t_reason')?.value || '';
                const reasonBlock = document.getElementById('tr_reason_block');
                if (reason) {
                    reasonBlock.style.display = 'block';
                    reasonBlock.innerHTML = `<strong>Motif / Note :</strong> ${reason}`;
                } else {
                    reasonBlock.style.display = 'none';
                }

                document.getElementById('print-transfer-container').style.display = 'block';
                window.print();
                document.getElementById('print-transfer-container').style.display = 'none';

            } catch (err) {
                console.error('Erreur impression :', err);
                showToast('Erreur lors de l\'impression du bon : ' + err.message, 'warning');
            }
        }

        async function reprintTransfer(id) {
            const token = localStorage.getItem("jwtToken");
            try {
                const resp = await fetch('/api/stockMovements/' + id, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!resp.ok) throw new Error('Erreur de chargement du mouvement');
                const movementData = await resp.json();
                await printTransferReceipt(movementData);
            } catch (e) {
                console.error(e);
                showToast("Erreur lors de la récupération du bon : " + e.message, "danger");
            }
        }

        async function loadMovements() {
            const token = localStorage.getItem("jwtToken");
            if (!token) { window.location.href = "/Login"; return; }

            const tbody = document.querySelector('#movementsTable tbody');
            tbody.innerHTML = '<tr><td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement...</td></tr>';

            try {
                const resp = await fetch('/api/stockMovements?pageNumber=1&pageSize=100', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (resp.status === 401) { window.location.href = "/Login"; return; }
                if (!resp.ok) throw new Error('Erreur API');

                const result = await resp.json();
                const movements = result.items || result;

                if (!movements || movements.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Aucun mouvement trouvé.</td></tr>';
                    return;
                }

                const badgeStyle = (type) => {
                    if (type === 0) return 'background:rgba(34,197,94,0.15); color:var(--success)';
                    if (type === 1) return 'background:rgba(239,68,68,0.15); color:var(--danger)';
                    return 'background:rgba(139,92,246,0.15); color:#8b5cf6';
                };
                const qtyStyle = (type) => {
                    if (type === 0) return `color:var(--success); font-weight:700`;
                    if (type === 1) return `color:var(--danger); font-weight:700`;
                    return `color:#8b5cf6; font-weight:700`;
                };
                const qtyPrefix = (type) => type === 0 ? '+' : (type === 1 ? '-' : '➔');

                const isTransfer = (type, label) => {
                    return type === 2 || type === 'TransfertBoutique' || (typeof label === 'string' && label.toLowerCase().includes('transfert'));
                };

                tbody.innerHTML = movements.map(m => {
                    const isTr = isTransfer(m.type, m.typeLabel);
                    return `
                    <tr>
                        <td style="font-size:0.85rem;">${new Date(m.movedAt).toLocaleString('fr-FR')}</td>
                        <td><span class="badge" style="${badgeStyle(m.type)}">${m.typeLabel}</span></td>
                        <td style="font-weight:500;">${m.productName || '#' + m.productId}</td>
                        <td style="${qtyStyle(m.type)}">${qtyPrefix(m.type)}${m.quantity}</td>
                        <td style="font-weight:500;">${m.stockAfterMovement}</td>
                        <td>
                            <div style="font-size:0.9rem;">${m.reason || '-'}</div>
                            <div style="font-size:0.78rem; color:var(--text-muted);">${m.reference || ''}</div>
                        </td>
                        <td>${m.delegatePerson ? `<span style="background:rgba(139,92,246,0.1); color:#8b5cf6; border-radius:5px; padding:2px 8px; font-size:0.85rem;"><i class='fa-solid fa-person-walking' style='margin-right:4px;'></i>${m.delegatePerson}</span>` : '<span style="color:var(--text-muted);">-</span>'}</td>
                        <td style="font-size:0.85rem;"><i class="fa-solid fa-user-circle" style="color:var(--text-muted); margin-right:4px;"></i>${m.userFullName || '#' + m.userId}</td>
                        <td style="text-align:center; white-space:nowrap;">
                            ${isTr ? `
                                <button class="btn-icon" title="Réimprimer le ticket de transfert" style="color: #8b5cf6; font-size: 1.1rem; padding: 4px 6px;" onclick="reprintTransfer(${m.id})">
                                    <i class="fa-solid fa-print"></i>
                                </button>
                                <button class="btn-icon" title="Télécharger le bon PDF" style="color: var(--danger); font-size: 1.1rem; padding: 4px 6px; margin-left: 4px;" onclick="downloadTransferReceipt(${m.id}, localStorage.getItem('jwtToken'))">
                                    <i class="fa-solid fa-file-pdf"></i>
                                </button>
                            ` : '<span style="color:var(--text-muted); font-size:0.8rem;">—</span>'}
                        </td>
                    </tr>
                `;
                }).join('');
            } catch (e) {
                console.error(e);
                tbody.innerHTML = '<tr><td colspan="9" class="text-center" style="color:var(--danger); padding:2rem;">Erreur lors du chargement.</td></tr>';
            }
        }

        document.addEventListener('DOMContentLoaded', loadMovements);
    </script>
}