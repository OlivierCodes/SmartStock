@page
@{
    ViewData["Title"] = "Stocks";
    Layout = "_DashboardLayout";
}

<div class="dashboard-header">
    <div class="dashboard-title">
        <h1>Gestion des Stocks</h1>
        <p>Aperçu en temps réel des stocks en Magasin (Réserve) et en Boutique (Rayon).</p>
    </div>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <button class="btn-secondary" onclick="openTransferModal()" style="padding: 0.6rem 1.1rem; font-size: 0.9rem; border-radius: 8px;">
            <i class="fa-solid fa-truck-fast"></i>
            <span>Prélèvement Magasin → Boutique</span>
        </button>
        <button class="btn-primary" onclick="loadStocksData()">
            <i class="fa-solid fa-rotate-right"></i>
            <span>Actualiser</span>
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
    <div class="glass-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #38bdf8;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(56, 189, 248, 0.15); display: flex; align-items: center; justify-content: center; color: #38bdf8; font-size: 1.4rem;">
            <i class="fa-solid fa-store"></i>
        </div>
        <div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">Total en Boutique</div>
            <div id="kpi_total_shop" style="font-size: 1.5rem; font-weight: 700; color: #38bdf8;">-</div>
        </div>
    </div>

    <div class="glass-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #a855f7;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(168, 85, 247, 0.15); display: flex; align-items: center; justify-content: center; color: #a855f7; font-size: 1.4rem;">
            <i class="fa-solid fa-warehouse"></i>
        </div>
        <div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">Total en Magasin (Réserve)</div>
            <div id="kpi_total_warehouse" style="font-size: 1.5rem; font-weight: 700; color: #a855f7;">-</div>
        </div>
    </div>

    <div class="glass-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid var(--success);">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(34, 197, 94, 0.15); display: flex; align-items: center; justify-content: center; color: var(--success); font-size: 1.4rem;">
            <i class="fa-solid fa-boxes-stacked"></i>
        </div>
        <div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">Stock Total Global</div>
            <div id="kpi_total_all" style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary);">-</div>
        </div>
    </div>

    <div class="glass-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid var(--danger);">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(239, 68, 68, 0.15); display: flex; align-items: center; justify-content: center; color: var(--danger); font-size: 1.4rem;">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">Alertes Stock Faible</div>
            <div id="kpi_low_stock" style="font-size: 1.5rem; font-weight: 700; color: var(--danger);">-</div>
        </div>
    </div>
</div>

<div class="glass-card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <h3 class="card-title" style="margin: 0;"><i class="fa-solid fa-list-check" style="color: var(--primary); margin-right: 8px;"></i>Inventaire des Stocks par Produit</h3>
        
        <div style="display: flex; gap: 0.75rem; align-items: center; flex: 1; max-width: 600px; flex-wrap: wrap;">
            <div style="position: relative; flex: 2; min-width: 200px;">
                <input type="text" id="stock_search_input" placeholder="🔍 Rechercher nom, SKU..." oninput="filterStocksTable()" style="width: 100%; padding-left: 2rem;">
                <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;"></i>
            </div>
            
            <div style="flex: 1; min-width: 150px;">
                <select id="stock_category_filter" onchange="filterStocksTable()" style="width: 100%;">
                    <option value="">Toutes les catégories</option>
                </select>
            </div>

            <div style="flex: 1; min-width: 140px;">
                <select id="stock_status_filter" onchange="filterStocksTable()" style="width: 100%;">
                    <option value="all">Tous les stocks</option>
                    <option value="shop_empty">Rayon Boutique vide</option>
                    <option value="warehouse_empty">Magasin vide</option>
                    <option value="low">Stock Total faible</option>
                </select>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table" id="stocksTable">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Nom du Produit</th>
                    <th>Catégorie</th>
                    <th style="color: #38bdf8; text-align: right;"><i class="fa-solid fa-store" style="margin-right: 4px;"></i>Stock Boutique</th>
                    <th style="color: #a855f7; text-align: right;"><i class="fa-solid fa-warehouse" style="margin-right: 4px;"></i>Stock Magasin</th>
                    <th style="text-align: right;"><i class="fa-solid fa-boxes-stacked" style="margin-right: 4px;"></i>Stock Total</th>
                    <th style="text-align: center;">Seuil d'Alerte</th>
                    <th style="text-align: center;">État</th>
                    <th style="text-align: center;">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement des données...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Prélèvement Rapide Magasin → Boutique -->
<div class="modal-overlay" id="transferModal">
    <div class="modal-content">
        <div class="modal-header" style="background: linear-gradient(135deg, rgba(139,92,246,0.15), rgba(59,130,246,0.1)); border-radius: 8px 8px 0 0; padding: 1rem 1.25rem;">
            <h3><i class="fa-solid fa-truck-fast" style="color: var(--primary);"></i> Prélèvement Magasin → Boutique</h3>
            <button class="modal-close" onclick="closeTransferModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="transferForm" onsubmit="saveTransfer(event)">
            <div class="form-group" style="margin-top: 1rem;">
                <label>Produit à prélever</label>
                <select id="t_product" required onchange="onTransferProductChange(this)">
                    <option disabled selected>Chargement...</option>
                </select>
            </div>
            
            <div id="t_stockInfo" style="display: none; margin-bottom: 1rem; padding: 0.75rem 1rem; border-radius: 8px; background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.2);">
                <div style="display: flex; gap: 1.5rem; font-size: 0.9rem;">
                    <div><i class="fa-solid fa-warehouse" style="color: #8b5cf6; margin-right: 5px;"></i><strong>Disponible en Magasin : </strong><span id="t_warehouseQty" style="font-weight: 700; color: #8b5cf6;">-</span></div>
                    <div><i class="fa-solid fa-store" style="color: #3b82f6; margin-right: 5px;"></i><strong>Actuel en Boutique : </strong><span id="t_shopQty" style="font-weight: 700; color: #3b82f6;">-</span></div>
                </div>
            </div>

            <div class="form-group">
                <label>Quantité à transférer vers la Boutique</label>
                <input type="number" id="t_quantity" required min="1" value="1">
            </div>

            <div class="form-group">
                <label><i class="fa-solid fa-user" style="color: var(--primary); margin-right: 5px;"></i>Personne déléguée (coursier / employé)</label>
                <input type="text" id="t_delegate" placeholder="Ex: Jean-Pierre, Vendeur Salle A" required>
            </div>

            <div class="form-group">
                <label>Raison / Note</label>
                <input type="text" id="t_reason" placeholder="Ex: Réapprovisionnement rayon boutique">
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeTransferModal()">Annuler</button>
                <button type="submit" class="btn-primary" style="background: linear-gradient(135deg, #8b5cf6, #3b82f6);">
                    <i class="fa-solid fa-truck-fast"></i> Valider le Prélèvement
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let allProducts = [];
        let allCategories = [];

        async function loadStocksData() {
            const token = localStorage.getItem("jwtToken");
            if (!token) {
                window.location.href = "/Login";
                return;
            }

            const tbody = document.querySelector('#stocksTable tbody');
            tbody.innerHTML = '<tr><td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Chargement des données...</td></tr>';

            try {
                // Charger produits et catégories en parallèle
                const [respProducts, respCategories] = await Promise.all([
                    fetch('/api/products?pageNumber=1&pageSize=200', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    }),
                    fetch('/api/categories', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    })
                ]);

                if (respProducts.status === 401) {
                    window.location.href = "/Login";
                    return;
                }

                if (!respProducts.ok) {
                    const err = await respProducts.json().catch(() => null);
                    throw new Error(err?.message || 'Erreur lors du chargement des stocks');
                }

                const resultProducts = await respProducts.json();
                allProducts = resultProducts.items || resultProducts;

                if (respCategories.ok) {
                    allCategories = await respCategories.json() || [];
                    populateCategoryFilter();
                }

                updateKpis();
                renderStocksTable(allProducts);

            } catch (e) {
                console.error("Erreur loadStocksData:", e);
                tbody.innerHTML = `<tr><td colspan="9" class="text-center" style="color: var(--danger); padding: 2rem;">Erreur : ${e.message}</td></tr>`;
            }
        }

        function populateCategoryFilter() {
            const select = document.getElementById('stock_category_filter');
            select.innerHTML = '<option value="">Toutes les catégories</option>' +
                allCategories.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
        }

        function updateKpis() {
            let totalShop = 0;
            let totalWarehouse = 0;
            let totalAll = 0;
            let lowStockCount = 0;

            allProducts.forEach(p => {
                const shop = p.shopStock ?? p.ShopStock ?? 0;
                const warehouse = p.warehouseStock ?? p.WarehouseStock ?? 0;
                const total = p.currentStock ?? p.CurrentStock ?? (shop + warehouse);
                const minThreshold = p.minStockThreshold ?? p.MinStockThreshold ?? 5;

                totalShop += shop;
                totalWarehouse += warehouse;
                totalAll += total;

                if (total <= minThreshold || shop === 0) {
                    lowStockCount++;
                }
            });

            document.getElementById('kpi_total_shop').innerText = totalShop.toLocaleString('fr-FR');
            document.getElementById('kpi_total_warehouse').innerText = totalWarehouse.toLocaleString('fr-FR');
            document.getElementById('kpi_total_all').innerText = totalAll.toLocaleString('fr-FR');
            document.getElementById('kpi_low_stock').innerText = lowStockCount;
        }

        function filterStocksTable() {
            const query = (document.getElementById('stock_search_input').value || '').trim().toLowerCase();
            const categoryId = document.getElementById('stock_category_filter').value;
            const statusFilter = document.getElementById('stock_status_filter').value;

            const filtered = allProducts.filter(p => {
                const name = (p.name || p.Name || '').toLowerCase();
                const sku = (p.sku || p.sKU || p.SKU || '').toLowerCase();
                const matchesSearch = !query || name.includes(query) || sku.includes(query);

                const matchesCategory = !categoryId || (p.categoryId ?? p.CategoryId) == categoryId;

                const shop = p.shopStock ?? p.ShopStock ?? 0;
                const warehouse = p.warehouseStock ?? p.WarehouseStock ?? 0;
                const total = p.currentStock ?? p.CurrentStock ?? (shop + warehouse);
                const minThreshold = p.minStockThreshold ?? p.MinStockThreshold ?? 5;

                let matchesStatus = true;
                if (statusFilter === 'shop_empty') {
                    matchesStatus = shop === 0;
                } else if (statusFilter === 'warehouse_empty') {
                    matchesStatus = warehouse === 0;
                } else if (statusFilter === 'low') {
                    matchesStatus = total <= minThreshold;
                }

                return matchesSearch && matchesCategory && matchesStatus;
            });

            renderStocksTable(filtered);
        }

        function renderStocksTable(products) {
            const tbody = document.querySelector('#stocksTable tbody');
            if (!products || products.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center" style="color: var(--text-muted); padding: 2rem;">Aucun produit ne correspond aux critères.</td></tr>';
                return;
            }

            tbody.innerHTML = products.map(p => {
                const shop = p.shopStock ?? p.ShopStock ?? 0;
                const warehouse = p.warehouseStock ?? p.WarehouseStock ?? 0;
                const total = p.currentStock ?? p.CurrentStock ?? (shop + warehouse);
                const threshold = p.minStockThreshold ?? p.MinStockThreshold ?? 5;
                const unit = p.unit || p.Unit || 'pcs';

                let statusBadge = '';
                if (total === 0) {
                    statusBadge = '<span class="badge" style="background: rgba(239, 68, 68, 0.2); color: var(--danger); font-weight: 600;">Rupture Totale</span>';
                } else if (shop === 0) {
                    statusBadge = '<span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; font-weight: 600;">Rayon Vide</span>';
                } else if (total <= threshold) {
                    statusBadge = '<span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; font-weight: 600;">Stock Faible</span>';
                } else {
                    statusBadge = '<span class="badge" style="background: rgba(34, 197, 94, 0.15); color: var(--success); font-weight: 600;">En Stock</span>';
                }

                return `
                    <tr>
                        <td><span class="badge" style="background: rgba(148, 163, 184, 0.15); color: var(--text-muted);">${p.sku || p.sKU || p.SKU || 'N/A'}</span></td>
                        <td style="font-weight: 600; color: var(--text-primary);">${p.name || p.Name}</td>
                        <td style="color: var(--text-muted); font-size: 0.9rem;">${p.categoryName || p.CategoryName || '-'}</td>
                        <td style="text-align: right;">
                            <span class="badge" style="background: ${shop === 0 ? 'rgba(239, 68, 68, 0.15)' : 'rgba(56, 189, 248, 0.15)'}; color: ${shop === 0 ? 'var(--danger)' : '#38bdf8'}; font-weight: 700; font-size: 0.9rem;">
                                <i class="fa-solid fa-store" style="margin-right: 4px;"></i>${shop} ${unit}
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <span class="badge" style="background: ${warehouse === 0 ? 'rgba(148, 163, 184, 0.15)' : 'rgba(168, 85, 247, 0.15)'}; color: ${warehouse === 0 ? 'var(--text-muted)' : '#a855f7'}; font-weight: 700; font-size: 0.9rem;">
                                <i class="fa-solid fa-warehouse" style="margin-right: 4px;"></i>${warehouse} ${unit}
                            </span>
                        </td>
                        <td style="text-align: right; font-weight: 700; font-size: 0.95rem; color: ${total <= threshold ? 'var(--danger)' : 'var(--text-primary)'};">
                            ${total} ${unit}
                        </td>
                        <td style="text-align: center; color: var(--text-muted); font-size: 0.85rem;">
                            ≤ ${threshold} ${unit}
                        </td>
                        <td style="text-align: center;">
                            ${statusBadge}
                        </td>
                        <td style="text-align: center; white-space: nowrap;">
                            <button class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px;" title="Prélever du stock magasin vers la boutique" onclick="openTransferModalForProduct(${p.id ?? p.Id})">
                                <i class="fa-solid fa-truck-fast" style="color: var(--primary);"></i>
                                <span style="margin-left: 4px;">Transférer</span>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function openTransferModal() {
            document.getElementById('transferForm').reset();
            document.getElementById('t_stockInfo').style.display = 'none';
            document.getElementById('transferModal').classList.add('show');
            
            const sel = document.getElementById('t_product');
            sel.innerHTML = `<option disabled selected>-- Sélectionner un produit --</option>` +
                allProducts.map(p =>
                    `<option value="${p.id}" data-shop="${p.shopStock ?? 0}" data-warehouse="${p.warehouseStock ?? 0}">[${p.sku || 'N/A'}] ${p.name}</option>`
                ).join('');
        }

        function openTransferModalForProduct(productId) {
            openTransferModal();
            const sel = document.getElementById('t_product');
            sel.value = productId;
            onTransferProductChange(sel);
        }

        function onTransferProductChange(sel) {
            const opt = sel.selectedOptions[0];
            if (!opt || !opt.dataset.warehouse) return;
            document.getElementById('t_warehouseQty').textContent = opt.dataset.warehouse + ' pcs';
            document.getElementById('t_shopQty').textContent = opt.dataset.shop + ' pcs';
            document.getElementById('t_stockInfo').style.display = 'block';
        }

        function closeTransferModal() {
            document.getElementById('transferModal').classList.remove('show');
        }

        async function saveTransfer(e) {
            e.preventDefault();
            const token = localStorage.getItem("jwtToken");
            const body = {
                productId: parseInt(document.getElementById('t_product').value),
                type: 2, // TransfertBoutique
                quantity: parseInt(document.getElementById('t_quantity').value),
                reason: document.getElementById('t_reason').value || 'Prélèvement vers boutique',
                delegatePerson: document.getElementById('t_delegate').value
            };
            try {
                const resp = await fetch('/api/stockMovements', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(body)
                });
                if (!resp.ok) {
                    const err = await resp.json().catch(() => null);
                    throw new Error(err?.message || 'Échec du transfert');
                }
                closeTransferModal();
                showToast('Prélèvement validé avec succès ! Stock boutique mis à jour.', 'success');
                loadStocksData();
            } catch (err) {
                showToast('Erreur: ' + err.message, 'danger');
            }
        }

        document.addEventListener('DOMContentLoaded', loadStocksData);
    </script>
}
